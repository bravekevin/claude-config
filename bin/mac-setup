#!/usr/bin/env bash
# 새 Mac 을 한 번에 개발 환경으로 준비하는 스크립트 (curl | bash 로 실행, 여러 번 실행해도 안전)
#
#   curl -fsSL https://raw.githubusercontent.com/bravekevin/claude-config/main/bin/mac-setup | bash
#
# 하는 일
#   1. Homebrew 설치(Xcode 명령줄 도구·git 포함) — Mac 비밀번호를 물어본다
#   2. gh, node 22, pnpm 설치 + PATH(~/.zprofile)
#   3. Vercel CLI 설치
#   4. git 사용자 이름·이메일 설정(없을 때만 물어봄)
#   5. GitHub 로그인(gh, 브라우저) + git 이 gh 로그인을 쓰게 설정
#   6. Vercel 로그인(브라우저)
#   7. ~/.claude-config 받기 → dev-bootstrap(비공개 저장소·메모리·hook·전역 지침·PATH)
#   8. 받을 프로젝트를 물어보고 ~/Dev/<폴더> 로 clone
#
# 환경변수로 물어보는 단계를 건너뛸 수 있다
#   MAC_SETUP_PROJECTS="bravekevin/zellytalk:ZellyTalk owner/repo:폴더"   (none 이면 건너뜀)
#   GIT_NAME, GIT_EMAIL

main() {
  set -eu
  TTY=/dev/tty
  have_tty() { [ -r "$TTY" ] && [ -w "$TTY" ] && : 2>/dev/null <"$TTY"; }
  ask() { # $1 질문 → 답을 출력
    local a=""
    if have_tty; then printf '%s ' "$1" >"$TTY"; IFS= read -r a <"$TTY" || true; fi
    printf '%s' "$a"
  }
  step() { printf '\n\033[1m▶ %s\033[0m\n' "$*"; }
  ok()   { printf '  ✓ %s\n' "$*"; }

  [ "$(uname -s)" = "Darwin" ] || { echo "macOS 전용입니다."; exit 1; }
  ARCH=$(uname -m)
  BREW_PREFIX=/opt/homebrew; [ "$ARCH" = "arm64" ] || BREW_PREFIX=/usr/local
  touch "$HOME/.zprofile"
  add_profile() { grep -qF "$1" "$HOME/.zprofile" || printf '\n%s\n' "$1" >>"$HOME/.zprofile"; }

  step "1. Homebrew (Xcode 명령줄 도구 포함)"
  if [ -x "$BREW_PREFIX/bin/brew" ]; then ok "이미 설치됨"
  else
    echo "  Mac 로그인 비밀번호를 입력하세요(화면에 표시되지 않습니다)."
    sudo -v <"$TTY"
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" </dev/null
  fi
  eval "$("$BREW_PREFIX/bin/brew" shellenv)"
  add_profile "eval \"\$($BREW_PREFIX/bin/brew shellenv)\""

  step "2. gh · node 22 · pnpm"
  for f in gh node@22 pnpm; do
    if brew list --formula "$f" >/dev/null 2>&1; then ok "$f 이미 있음"; else brew install "$f" </dev/null; fi
  done
  NODE_BIN="$(brew --prefix node@22)/bin"
  export PATH="$NODE_BIN:$PATH"
  add_profile "export PATH=\"$NODE_BIN:\$PATH\""
  ok "node $(node -v), pnpm $(pnpm -v), gh $(gh --version | head -1 | awk '{print $3}')"

  step "3. Vercel CLI"
  if command -v vercel >/dev/null 2>&1; then ok "이미 있음"; else npm install -g vercel </dev/null >/dev/null; ok "설치함"; fi

  step "4. git 사용자"
  if [ -z "$(git config --global user.name || true)" ]; then
    n="${GIT_NAME:-$(ask '  커밋 작성자 이름(예: GitHub 아이디):')}"
    [ -n "$n" ] && git config --global user.name "$n"
  fi
  if [ -z "$(git config --global user.email || true)" ]; then
    e="${GIT_EMAIL:-$(ask '  커밋 작성자 이메일:')}"
    [ -n "$e" ] && git config --global user.email "$e"
  fi
  ok "$(git config --global user.name || echo '(이름 없음)') <$(git config --global user.email || echo '이메일 없음')>"

  step "5. GitHub 로그인"
  if gh auth status >/dev/null 2>&1; then ok "이미 로그인: $(gh api user -q .login)"
  else
    echo "  브라우저가 열리면 GitHub 에 로그인하세요. 화면에 나오는 코드를 입력합니다."
    gh auth login --hostname github.com --git-protocol https --web <"$TTY"
  fi
  gh auth setup-git
  ok "git 이 gh 로그인을 사용"

  step "6. Vercel 로그인"
  if vercel whoami >/dev/null 2>&1; then ok "이미 로그인: $(vercel whoami 2>/dev/null | tail -1)"
  elif have_tty; then
    echo "  브라우저가 열리면 Vercel 에 로그인하세요."
    vercel login <"$TTY" || echo "  ! Vercel 로그인을 건너뜀 — 나중에 'vercel login'"
  else echo "  ! 터미널이 없어 건너뜀 — 나중에 'vercel login'"; fi

  step "7. 전역 지침·도구 + 비공개 저장소·메모리·hook"
  if [ -d "$HOME/.claude-config/.git" ]; then git -C "$HOME/.claude-config" pull -q --ff-only && ok "claude-config 갱신"
  else git clone -q https://github.com/bravekevin/claude-config.git "$HOME/.claude-config" && ok "claude-config 받음"; fi
  "$HOME/.claude-config/bin/dev-bootstrap" </dev/null

  step "8. 프로젝트 받기 (~/Dev)"
  P="${MAC_SETUP_PROJECTS:-}"
  if [ -z "$P" ]; then
    echo "  받을 저장소를 '계정/저장소:폴더이름' 형식으로 띄어쓰기로 구분해 입력하세요."
    echo "  폴더 이름은 다른 컴퓨터와 같게(Claude 메모리 연결). 예: bravekevin/zellytalk:ZellyTalk"
    P="$(ask '  저장소(없으면 엔터):')"
  fi
  [ "$P" = "none" ] && P=""
  mkdir -p "$HOME/Dev"
  for item in $P; do
    repo="${item%%:*}"; dir="${item#*:}"; [ "$dir" = "$item" ] && dir="${repo##*/}"
    if [ -d "$HOME/Dev/$dir/.git" ]; then git -C "$HOME/Dev/$dir" pull -q --ff-only && ok "$dir 갱신"
    else gh repo clone "$repo" "$HOME/Dev/$dir" -- -q </dev/null && ok "$repo → ~/Dev/$dir" || echo "  ! $repo 받기 실패(권한·계정 확인)"; fi
  done
  python3 "$HOME/.claude-private/bin/link-memory" >/dev/null 2>&1 || true

  cat <<'EOF'

✅ 준비 끝. 다음은 직접:
  1. Claude 앱을 껐다 켭니다(새 PATH 적용). 터미널도 새로 엽니다.
  2. 프로젝트 env: 프로젝트 폴더에서  vercel link  →  vercel env pull .env.local --environment=development
  3. 장기 키가 필요하면  tok set <키이름>  (이름 목록: ~/.claude-private/tokens/TOKEN_INVENTORY.md)
  4. Claude 새 세션: "이 컴퓨터" → ~/Dev/<폴더> 선택
  5. 점검: git-safety audit ~/Dev/<폴더>
EOF
}

# curl | bash 로 실행될 때 스크립트를 끝까지 읽은 뒤 실행하도록 함수로 감싼다
main "$@"
